---
import { CONTACT_PHONE_DISPLAY, CONTACT_PHONE_TEL } from '../../config/site';
export interface Props { heading?: string }
const { heading = 'See it on your own cameras' } = Astro.props;
---
<section class="cta on-stage">
  <div class="wrap inner">
    <h2>{heading}</h2>
    <div class="actions">
      <a class="btn btn-lime" href="/demo">Book a walkthrough</a>
      <a class="btn btn-secondary" href={CONTACT_PHONE_TEL}>Call {CONTACT_PHONE_DISPLAY}</a>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: var(--space-9); }
  h2 { color: var(--stage-ink); }
  .inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); flex-wrap: wrap; }
  h2 { max-width: 18ch; }
  .actions { display: flex; gap: var(--space-3); flex-wrap: wrap; }
</style>
