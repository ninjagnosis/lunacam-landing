---
import { Image } from 'astro:assets';
import { photos } from '../../data/photos';
import { CONTACT_PHONE_DISPLAY, CONTACT_PHONE_TEL } from '../../config/site';
---
<section class="hero on-stage">
  <div class="wrap grid">
    <div class="copy">
      <h1 class="display">{'Your cameras. Your footage. Your country.'.split(' ').map((w, i) => (<><span class="w"><span style={`--i:${i}`}>{w}</span></span>{' '}</>))}</h1>
      <div class="actions">
        <a class="btn btn-lime" href="/demo">Book a walkthrough</a>
        <a class="btn btn-secondary" href={CONTACT_PHONE_TEL}>Call {CONTACT_PHONE_DISPLAY}</a>
      </div>
    </div>
    <div class="stage">
      <Image src={photos.hero.src} alt={photos.hero.alt.en} widths={[480, 720, 960]} sizes="(max-width: 959px) 100vw, 520px" quality={85} format="webp" class="photo" loading="eager" />
    </div>
  </div>
</section>

<style>
  .hero { padding-block: var(--space-9); overflow: hidden; }
  .grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: var(--space-8); align-items: center; }
  .display { color: var(--stage-ink); max-width: 12ch; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-7); }
  .photo { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-panel); }
  @media (max-width: 959px) {
    .hero { padding-block: var(--space-8); }
    .grid { grid-template-columns: 1fr; gap: var(--space-7); }
  }
</style>
