---
import { Image } from 'astro:assets';
import EventFeed from '../demos/EventFeed.astro';
import { testimonials } from '../../data/testimonials';
import { photos } from '../../data/photos';
---
<section class="section proof" data-reveal>
  <div class="wrap grid">
    <div class="side">
      <h2>Your footage stays in Nepal</h2>
      <Image src={photos.street.src} alt={photos.street.alt.en} widths={[400, 800]} sizes="(max-width: 959px) 100vw, 480px" quality={85} format="webp" class="photo" />
    </div>
    <div class="convo"><EventFeed feed="alerts" /></div>
  </div>
  {testimonials.length > 0 && (
    <div class="wrap quotes">
      {testimonials.map((t) => (
        <figure>
          <blockquote>{t.quote}</blockquote>
          <figcaption>{t.name}, {t.business}</figcaption>
        </figure>
      ))}
    </div>
  )}
</section>

<style>
  .proof { background: var(--surface); }
  .grid { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: var(--space-5); align-items: stretch; }
  .side { display: grid; grid-template-rows: auto 1fr; gap: var(--space-5); padding: var(--space-7); border-radius: var(--radius-panel); background: var(--subtle); }
  .side h2 { max-width: 13ch; }
  .photo { width: 100%; height: 100%; min-height: 220px; object-fit: cover; border-radius: 8px; }
  .quotes { margin-top: var(--space-8); display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-6); }
  figure { margin: 0; }
  blockquote { margin: 0 0 var(--space-3); font-size: 1.25rem; }
  figcaption { color: var(--ink-muted); font-size: 16px; }
  @media (max-width: 959px) { .grid { grid-template-columns: 1fr; } .side { padding: var(--space-5); } }
</style>
