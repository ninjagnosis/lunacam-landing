---
// A playback timeline with event markers, as an example of the screen.
const marks = [
  { at: 12, kind: 'Motion' }, { at: 26, kind: 'Person' }, { at: 41, kind: 'Vehicle' },
  { at: 58, kind: 'Person' }, { at: 73, kind: 'Motion' }, { at: 88, kind: 'Person' },
];
const hours = ['06:00', '09:00', '12:00', '15:00', '18:00', '21:00'];
---
<div class="tl" role="img" aria-label="Example playback timeline for one day with six event markers">
  <div class="bar"><span>Counter, today</span><span class="muted">6 events</span></div>
  <div class="body">
    <div class="track">
      <span class="rec" aria-hidden="true"></span>
      {marks.map((m) => <span class={`mark ${m.kind.toLowerCase()}`} style={`left:${m.at}%`} aria-hidden="true"></span>)}
    </div>
    <div class="hours" aria-hidden="true">{hours.map((h) => <span>{h}</span>)}</div>
    <ul class="legend">
      <li><span class="mark motion"></span>Motion</li>
      <li><span class="mark person"></span>Person</li>
      <li><span class="mark vehicle"></span>Vehicle</li>
    </ul>
    <p class="clip"><span class="btn-sm">Cut clip</span>Mark start and end, then download or share.</p>
  </div>
</div>

<style>
  .tl { background: var(--canvas); border: 1px solid var(--line); border-radius: var(--radius-panel); overflow: hidden; }
  .bar { display: flex; justify-content: space-between; padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--line); font-weight: 600; font-size: 16px; }
  .muted { font-weight: 400; color: var(--ink-muted); }
  .body { padding: var(--space-5) var(--space-4); display: grid; gap: var(--space-3); }
  .track { position: relative; height: 40px; border-radius: 8px; background: var(--subtle); }
  .rec { position: absolute; inset: 14px 0; background: var(--line); border-radius: 4px; }
  .mark { position: absolute; top: 6px; width: 8px; height: 28px; border-radius: 3px; background: var(--brand); }
  .mark.person { background: var(--ink); }
  .mark.vehicle { background: var(--lime); }
  .hours { display: flex; justify-content: space-between; font-size: 14px; color: var(--ink-muted); font-variant-numeric: tabular-nums; }
  .legend { list-style: none; margin: 0; padding: 0; display: flex; gap: var(--space-5); font-size: 15px; }
  .legend li { display: flex; align-items: center; gap: var(--space-2); }
  .legend .mark { position: static; width: 8px; height: 16px; }
  .clip { margin: 0; display: flex; align-items: center; gap: var(--space-3); font-size: 15px; color: var(--ink-muted); }
  .btn-sm { padding: 4px 12px; border-radius: 8px; background: var(--brand); color: var(--on-brand); font-weight: 600; font-size: 15px; }
</style>
