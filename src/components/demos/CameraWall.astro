---
// A camera grid as the app shows it. The pictures are real photos from Nepal;
// the layout is an example, not a customer's site.
import { Image } from 'astro:assets';
import { photos } from '../../data/photos';
const tiles = [
  { p: photos.home, name: 'Front gate', live: true },
  { p: photos.shop, name: 'Counter', live: true },
  { p: photos.street, name: 'Main road', live: true },
  { p: photos.site, name: 'Stockroom', live: false },
];
---
<div class="wall" role="img" aria-label="Example camera grid in the LunaCam app, four cameras">
  <div class="bar"><span>Example grid</span><span class="muted">4 cameras</span></div>
  <ul class="tiles">
    {tiles.map((t) => (
      <li>
        <Image src={t.p.src} alt="" widths={[260, 520]} sizes="(max-width: 959px) 45vw, 260px" format="webp" class="pic" />
        <span class="name">{t.name}</span>
        <span class={`state ${t.live ? 'live' : 'off'}`}>{t.live ? 'Live' : 'Offline'}</span>
      </li>
    ))}
  </ul>
</div>

<style>
  .wall { background: var(--canvas); border: 1px solid var(--line); border-radius: var(--radius-panel); overflow: hidden; }
  .bar { display: flex; justify-content: space-between; padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--line); font-weight: 600; font-size: 16px; }
  .muted { font-weight: 400; color: var(--ink-muted); }
  .tiles { list-style: none; margin: 0; padding: var(--space-2); display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2); }
  li { position: relative; overflow: hidden; border-radius: 8px; aspect-ratio: 4 / 3; background: var(--subtle); }
  .pic { display: block; width: 100%; height: 100%; object-fit: cover; }
  li:has(.off) .pic { filter: grayscale(1); opacity: 0.45; }
  .name, .state { position: absolute; padding: 2px 8px; border-radius: 6px; font-size: 14px; line-height: 1.4; background: var(--stage); color: var(--stage-ink); }
  .name { left: 8px; bottom: 8px; }
  .state { right: 8px; top: 8px; }
  .state.live { background: var(--brand); }
</style>
