---
import Base from '../layouts/Base.astro';
import { CONTACT_PHONE_DISPLAY, CONTACT_PHONE_TEL } from '../config/site';
---
<Base title="Thanks" description="Thanks for getting in touch with LunaCam. We will call you within one working day." path="/thanks" noindex>
  <section class="section">
    <div class="wrap prose">
      <h1>Thanks, we have your details</h1>
      <p>We will call you within one working day. To speak sooner, ring <a href={CONTACT_PHONE_TEL}>{CONTACT_PHONE_DISPLAY}</a>.</p>
      <p><a href="/">Back to the home page</a></p>
    </div>
  </section>
</Base>
